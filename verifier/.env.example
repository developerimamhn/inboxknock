# Where the service listens.
PORT=8787
HOST=0.0.0.0

# Shared secret. Put the same value in the website's VERIFY_API_KEY.
# When set, every request must send "Authorization: Bearer <API_KEY>".
API_KEY=

# SMTP probe. Needs outbound port 25. Set to off if your host blocks it
# (then the mailbox and catch-all checks are skipped and results are Unknown).
SMTP_PROBE=on
# Name this server gives in EHLO. Use a real hostname that points to this server,
# with matching reverse DNS (PTR). Many mail servers refuse probes without it.
SMTP_HELO=verify.inboxknock.com
# Sender used in MAIL FROM. Use an address on a domain you own.
SMTP_FROM=verify@inboxknock.com
SMTP_TIMEOUT_MS=10000
# Try STARTTLS when the mail server offers it.
SMTP_STARTTLS=on
# Most connections open at once to one mail server.
SMTP_PER_HOST=3

DNS_TIMEOUT_MS=5000

# Free checks per visitor per calendar month (UTC). Keep in step with FREE_MONTHLY_CHECKS on the site.
FREE_MONTHLY_CHECKS=10000
# Checks per visitor per minute before 429.
RATE_PER_MINUTE=60

# Usage counts and downloaded lists live here.
DATA_DIR=./data

# Most SMTP probes this server starts per minute (all mail servers together), and per mail server.
# Keeps the IP off block lists. Extra checks answer Unknown instead of waiting.
SMTP_MAX_PER_MINUTE=60
SMTP_HOST_PER_MINUTE=20

# Send only the mailbox and catch-all checks to an SMTP worker on a VPS (port 25 open).
# Set these on Vercel. Leave empty on the VPS itself.
SMTP_WORKER_URL=
SMTP_WORKER_KEY=
SMTP_WORKER_TIMEOUT_MS=15000
