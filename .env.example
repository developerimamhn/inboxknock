# Public site address. Used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://inboxknock.com

# Your verification backend (full endpoint, for example http://localhost:8787/verify).
# On Vercel leave this empty: the verifier service binding sets VERIFIER_URL for you.
# When neither exists in production, the hero checker becomes an early access form.
VERIFY_API_URL=
# Shared secret between the site and the verifier. Required on Vercel.
VERIFY_API_KEY=

# Where early access sign-ups are forwarded (a webhook that accepts JSON {email, lang}).
EARLY_ACCESS_WEBHOOK_URL=
